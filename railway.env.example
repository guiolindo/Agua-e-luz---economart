# Variáveis para colar no Railway: serviço web -> Variables -> "Raw Editor".
# Preencha os campos vazios. Não coloque valores reais neste arquivo nem faça commit de um .env com segredos.

# Banco: referencia o plugin PostgreSQL do projeto (troque "Postgres" pelo nome do seu serviço de banco, se for outro)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EXTRACTION_PROVIDER=gemini
GEMINI_MAX_CONCURRENCY=2

# Segurança (em produção DEBUG fica false e SECRET_KEY é obrigatória)
DEBUG=false
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Administrador criado no primeiro start (se ainda não existir nenhum usuário)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Upload e retenção
MAX_UPLOAD_MB=12
DOCUMENT_RETENTION_DAYS=183
RETENTION_CHECK_HOURS=6
