# --- Gemini (a chave NUNCA vai para o código; configure no .env local ou nas Variables do Railway)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# "gemini" (real) ou "mock" (usa tests/fixtures/cemig_set_2026.json, sem consumir créditos)
EXTRACTION_PROVIDER=gemini
# Chamadas simultâneas ao Gemini (a cota gratuita é ~15 pedidos/min)
GEMINI_MAX_CONCURRENCY=2

# --- Banco (SQLite local; PostgreSQL em produção, ex.: a variável DATABASE_URL fornecida pelo Railway)
DATABASE_URL=sqlite:///app.db

# --- Segurança
SECRET_KEY=
DEBUG=true
# Chave de criptografia dos documentos no banco (obrigatória em produção). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=
# Quantos proxies existem na frente do app (Railway = 1). Define de onde vem o IP real nos limites e na auditoria.
TRUSTED_PROXY_COUNT=1

# --- Primeiro acesso: o usuário admin é criado automaticamente se ainda não existir
ADMIN_USERNAME=admin
# Em produção: mínimo 12 caracteres, misturando letras e números/símbolos.
ADMIN_PASSWORD=

# --- Upload
MAX_UPLOAD_MB=12
# A foto/PDF original é apagada do banco após este prazo (183 dias ≈ 6 meses); os dados lidos permanecem.
DOCUMENT_RETENTION_DAYS=183

# Obriga todo administrador a configurar o 2FA (Google Authenticator)
REQUIRE_ADMIN_2FA=false
