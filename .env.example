# --- Gemini (a chave NUNCA vai para o código; configure no .env local ou nas Variables do Railway)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# "gemini" (real) ou "mock" (usa tests/fixtures/cemig_set_2026.json, sem consumir créditos)
EXTRACTION_PROVIDER=gemini

# --- Banco (SQLite local; PostgreSQL em produção, ex.: a variável DATABASE_URL fornecida pelo Railway)
DATABASE_URL=sqlite:///app.db

# --- Segurança
SECRET_KEY=
DEBUG=true

# --- Primeiro acesso: o usuário admin é criado automaticamente se ainda não existir
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Upload
MAX_UPLOAD_MB=15
